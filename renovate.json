{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "schedule": ["at any time"],
  "automergeSchedule": ["at any time"],
  "minimumReleaseAge": "0 days",
  "dependencyDashboardApproval": false,
  "prCreation": "approval",
  "configMigration": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Apply all eligible updates directly to the base branch without automatic pull requests",
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "schedule": ["at any time"],
      "automergeSchedule": ["at any time"],
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "prCreation": "approval"
    }
  ],
  "vulnerabilityAlerts": {
    "prCreation": "approval"
  }
}
